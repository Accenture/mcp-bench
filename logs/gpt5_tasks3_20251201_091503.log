nstream determining factors of activity across pan-cancer and normal tissues.","doi":"10.1016/j.ejca.2023.113379","published_date":"2023-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/37913680/","source":"pubmed","updated_date":"2023-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""}]
