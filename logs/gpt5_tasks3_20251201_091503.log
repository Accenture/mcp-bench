Tool `Paper Search:search_pubmed` with Parameter {'query': 'CIViC open knowledgebase Griffith M Genome Medicine 2017 Clinical Interpretation of Variants in Cancer', 'max_results': 10} on Paper Search succeeded. Result: [{"paper_id":"28138153","title":"CIViC is a community knowledgebase for expert crowdsourcing the clinical interpretation of variants in cancer.","authors":"Griffith M; Spies NC; Krysiak K; McMichael JF; Coffman AC; Danos AM; Ainscough BJ; Ramirez CA; Rieke DT; Kujan L; Barnell EK; Wagner AH; Skidmore ZL; Wollam A; Liu CJ; Jones MR; Bilski RL; Lesurf R; Feng YY; Shah NM; Bonakdar M; Trani L; Matlock M; Ramu A; Campbell KM; Spies GC; Graubert AP; Gangavarapu K; Eldred JM; Larson DE; Walker JR; Good BM; Wu C; Su AI; Dienstmann R; Margolin AA; Tamborero D; Lopez-Bigas N; Jones SJ; Bose R; Spencer DH; Wartman LD; Wilson RK; Mardis ER; Griffith OL","abstract":"CIViC is an expert-crowdsourced knowledgebase for Clinical Interpretation of Variants in Cancer describing the therapeutic, prognostic, diagnostic and predisposing relevance of inherited and somatic variants of all types. CIViC is committed to open-source code, open-access content, public application programming interfaces (APIs) and provenance of supporting evidence to allow for the transparent creation of current and accurate variant interpretations for use in cancer precision medicine.","doi":"10.1038/ng.3774","published_date":"2017-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/28138153/","source":"pubmed","updated_date":"2017-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""}]
Tool `Paper Search:search_pubmed` with Parameter {'query': 'Cancer Genome Interpreter Tamborero 2018 Cancer Research', 'max_results': 10} on Paper Search succeeded. Result: [{"paper_id":"29666300","title":"A Pan-cancer Landscape of Interactions between Solid Tumors and Infiltrating Immune Cell Populations.","authors":"Tamborero D; Rubio-Perez C; Muiños F; Sabarinathan R; Piulats JM; Muntasell A; Dienstmann R; Lopez-Bigas N; Gonzalez-Perez A","abstract":null,"doi":"10.1158/1078-0432.CCR-17-3509","published_date":"2018-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/29666300/","source":"pubmed","updated_date":"2018-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""},{"paper_id":"29592813","title":"Cancer Genome Interpreter annotates the biological and clinical relevance of tumor alterations.","authors":"Tamborero D; Rubio-Perez C; Deu-Pons J; Schroeder MP; Vivancos A; Rovira A; Tusquets I; Albanell J; Rodon J; Tabernero J; de Torres C; Dienstmann R; Gonzalez-Perez A; Lopez-Bigas N","abstract":"While tumor genome sequencing has become widely available in clinical and research settings, the interpretation of tumor somatic variants remains an important bottleneck. Here we present the Cancer Genome Interpreter, a versatile platform that automates the interpretation of newly sequenced cancer genomes, annotating the potential of alterations detected in tumors to act as drivers and their possible effect on treatment response. The results are organized in different levels of evidence according to current knowledge, which we envision can support a broad range of oncology use cases. The resource is publicly available at http://www.cancergenomeinterpreter.org .","doi":"10.1186/s13073-018-0531-8","published_date":"2018-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/29592813/","source":"pubmed","updated_date":"2018-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""}]
