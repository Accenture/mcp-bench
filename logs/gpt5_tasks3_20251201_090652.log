Tool `Paper Search:search_pubmed` with Parameter {'query': 'coBRIM 2014 N Engl J Med cobimetinib vemurafenib melanoma', 'max_results': 10} on Paper Search succeeded. Result: [{"paper_id":"25265494","title":"Combined vemurafenib and cobimetinib in BRAF-mutated melanoma.","authors":"Larkin J; Ascierto PA; Dréno B; Atkinson V; Liszkay G; Maio M; Mandalà M; Demidov L; Stroyakovskiy D; Thomas L; de la Cruz-Merino L; Dutriaux C; Garbe C; Sovak MA; Chang I; Choong N; Hack SP; McArthur GA; Ribas A","abstract":"The combined inhibition of BRAF and MEK is hypothesized to improve clinical outcomes in patients with melanoma by preventing or delaying the onset of resistance observed with BRAF inhibitors alone. This randomized phase 3 study evaluated the combination of the BRAF inhibitor vemurafenib and the MEK inhibitor cobimetinib.","doi":"10.1056/NEJMoa1408868","published_date":"2014-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/25265494/","source":"pubmed","updated_date":"2014-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""}]
Tool `Paper Search:search_pubmed` with Parameter {'query': 'COLUMBUS 7-year update 2024 European Journal of Cancer encorafenib binimetinib melanoma', 'max_results': 10} on Paper Search succeeded. Result: [{"paper_id":"38723373","title":"COLUMBUS 7-year update: A randomized, open-label, phase III trial of encorafenib plus binimetinib versus vemurafenib or encorafenib in patients with BRAF V600E/K-mutant melanoma.","authors":"Schadendorf D; Dummer R; Flaherty KT; Robert C; Arance A; de Groot JWB; Garbe C; Gogas HJ; Gutzmer R; Krajsová I; Liszkay G; Loquai C; Mandalà M; Yamazaki N; Queirolo P; Guenzel C; Polli A; Thakur M; di Pietro A; Ascierto PA","abstract":"Treatment with encorafenib plus binimetinib and encorafenib monotherapy is associated with improved progression-free survival (PFS) and overall survival (OS) compared with vemurafenib in patients with BRAF V600E/K-mutant metastatic melanoma. We report results from the 7-year analysis of COLUMBUS part 1 (NCT01909453) at 99.7 months (median duration between randomization and data cutoff).","doi":"10.1016/j.ejca.2024.114073","published_date":"2024-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/38723373/","source":"pubmed","updated_date":"2024-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""}]
