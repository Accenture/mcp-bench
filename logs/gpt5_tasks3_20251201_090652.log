Tool `Paper Search:search_pubmed` with Parameter {'query': 'SECOMBIT Nature Communications 2024 4-year overall survival BRAF V600 melanoma encorafenib binimetinib ipilimumab nivolumab', 'max_results': 10} on Paper Search succeeded. Result: [{"paper_id":"38167503","title":"Sequential immunotherapy and targeted therapy for metastatic BRAF V600 mutated melanoma: 4-year survival and biomarkers evaluation from the phase II SECOMBIT trial.","authors":"Ascierto PA; Casula M; Bulgarelli J; Pisano M; Piccinini C; Piccin L; Cossu A; Mandalà M; Ferrucci PF; Guidoboni M; Rutkowski P; Ferraresi V; Arance A; Guida M; Maiello E; Gogas H; Richtig E; Fierro MT; Lebbe C; Helgadottir H; Queirolo P; Spagnolo F; Tucci M; Del Vecchio M; Cao MG; Minisini AM; De Placido S; Sanmamed MF; Mallardo D; Paone M; Vitale MG; Melero I; Grimaldi AM; Giannarelli D; Dummer R; Sileni VC; Palmieri G","abstract":"No prospective data were available prior to 2021 to inform selection between combination BRAF and MEK inhibition versus dual blockade of programmed cell death protein-1 (PD-1) and cytotoxic T lymphocyte antigen-4 (CTLA-4) as first-line treatment options for BRAFV600-mutant melanoma. SECOMBIT (NCT02631447) was a randomized, three-arm, noncomparative phase II trial in which patients were randomized to one of two sequences with immunotherapy or targeted therapy first, with a third arm in which an 8-week induction course of targeted therapy followed by a planned switch to immunotherapy was the first treatment. BRAF/MEK inhibitors were encorafenib plus binimetinib and checkpoint inhibitors ipilimumab plus nivolumab. Primary outcome of overall survival was previously reported, demonstrating improved survival with immunotherapy administered until progression and followed by BRAF/MEK inhibition. Here we report 4-year survival outcomes, confirming long-term benefit with first-line immunotherapy. We also describe preliminary results of predefined biomarkers analyses that identify a trend toward improved 4-year overall survival and total progression-free survival in patients with loss-of-function mutations affecting JAK or low baseline levels of serum interferon gamma (IFNy). These long-term survival outcomes confirm immunotherapy as the preferred first-line treatment approach for most patients with BRAFV600-mutant metastatic melanoma, and the biomarker analyses are hypothesis-generating for future investigations of predictors of durable benefit with dual checkpoint blockade and targeted therapy.","doi":"10.1038/s41467-023-44475-6","published_date":"2024-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/38167503/","source":"pubmed","updated_date":"2024-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""}]
Tool `Paper Search:search_pubmed` with Parameter {'query': 'IMspire150 2020 Lancet atezolizumab vemurafenib cobimetinib investigator-assessed progression-free survival hazard ratio melanoma', 'max_results': 10} on Paper Search succeeded. Result: [{"paper_id":"32534646","title":"Atezolizumab, vemurafenib, and cobimetinib as first-line treatment for unresectable advanced BRAF","authors":"Gutzmer R; Stroyakovskiy D; Gogas H; Robert C; Lewis K; Protsenko S; Pereira RP; Eigentler T; Rutkowski P; Demidov L; Manikhas GM; Yan Y; Huang KC; Uyei A; McNally V; McArthur GA; Ascierto PA","abstract":"IMspire150 aimed to evaluate first-line combination treatment with BRAF plus MEK inhibitors and immune checkpoint therapy in BRAF","doi":"10.1016/S0140-6736(20)30934-X","published_date":"2020-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/32534646/","source":"pubmed","updated_date":"2020-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""}]
Tool `Paper Search:search_pubmed` with Parameter {'query': 'Ascierto 2023 Lancet Oncology IMspire150 overall survival atezolizumab vemurafenib cobimetinib melanoma', 'max_results': 10} on Paper Search succeeded. Result: [{"paper_id":"36460017","title":"Overall survival with first-line atezolizumab in combination with vemurafenib and cobimetinib in BRAF","authors":"Ascierto PA; Stroyakovskiy D; Gogas H; Robert C; Lewis K; Protsenko S; Pereira RP; Eigentler T; Rutkowski P; Demidov L; Zhukova N; Schachter J; Yan Y; Caro I; Hertig C; Xue C; Kusters L; McArthur GA; Gutzmer R","abstract":"Primary analysis of the phase 3 IMspire150 study showed improved investigator-assessed progression-free survival with first-line atezolizumab, vemurafenib, and cobimetinib (atezolizumab group) versus placebo, vemurafenib, and cobimetinib (control group) in patients with BRAF","doi":"10.1016/S1470-2045(22)00687-8","published_date":"2023-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/36460017/","source":"pubmed","updated_date":"2023-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""}]
