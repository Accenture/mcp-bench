2025-12-01 09:47:13,717 - agent.executor - INFO -     Tool result: [{"paper_id":"38683104","title":"A Phase II Study of ERK Inhibition by Ulixertinib (BVD-523) in Metastatic Uveal Melanoma.","authors":"Buchbinder EI; Cohen JV; Tarantino G; Lian CG; Liu D; Haq R; Hodi FS; Lawrence DP; Giobbie-Hurder A; Knoerzer D; Sullivan RJ","abstract":"Uveal melanoma is a rare and aggressive subset of melanoma that is minimally responsive to traditional therapies. Greater than 80% of uveal melanomas have a mutation in GNAQ or GNA11 which lead to downstream signaling through the MAPK pathway. Ulixertinib (BVD-523) is a potent and reversible small-molecule ATP-competitive inhibitor of both ERK1 and ERK2 protein kinases.","doi":"10.1158/2767-9764.CRC-24-0036","published_date":"2024-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/38683104/","source":"pubmed","updated_date":"2024-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""}]
