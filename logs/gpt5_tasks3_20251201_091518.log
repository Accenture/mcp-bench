2025-12-01 11:29:23,399 - agent.executor - INFO -     Tool result: [{"paper_id":"41142596","title":"Somatic gene variation profiles in geriatric and adult malignant melanoma patients.","authors":"Ekinci B; Erdogdu IH; Orenay-Boyacioglu S; Boyacioglu O; Kahraman-Cetin N; Akin D; Turan M; Tataroglu C","abstract":"Skin cancer is a highly heterogeneous disease affecting substantial geriatric individuals. Therefore, understanding gene variants and their presence in geriatric and adult skin cancer patient groups is valuable for the improvement of healthcare policies. The somatic variation profile in geriatric patients diagnosed with malignant melanoma (MM) was examined retrospectively by comparing them to the younger cases to reveal the clinical importance of the panel tests.","doi":"10.3389/fonc.2025.1649387","published_date":"2025-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/41142596/","source":"pubmed","updated_date":"2025-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""},{"paper_id":"41099287"...
