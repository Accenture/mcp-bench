Tool `Paper Search:search_pubmed` with Parameter {'query': '"Health system-scale language models are all-purpose prediction engines" Nature 2023', 'max_results': 10} on Paper Search succeeded. Result: [{"paper_id":"37286606","title":"Health system-scale language models are all-purpose prediction engines.","authors":"Jiang LY; Liu XC; Nejatian NP; Nasir-Moin M; Wang D; Abidin A; Eaton K; Riina HA; Laufer I; Punjabi P; Miceli M; Kim NC; Orillac C; Schnurman Z; Livia C; Weiss H; Kurland D; Neifert S; Dastagirzada Y; Kondziolka D; Cheung ATM; Yang G; Cao M; Flores M; Costa AB; Aphinyanaphongs Y; Cho K; Oermann EK","abstract":"Physicians make critical time-constrained decisions every day. Clinical predictive models can help physicians and administrators make decisions by forecasting clinical and operational events. Existing structured data-based clinical predictive models have limited use in everyday practice owing to complexity in data processing, as well as model development and deployment","doi":"10.1038/s41586-023-06160-y","published_date":"2023-01-01T00:00:00","pdf_url":"","url":"https://pubmed.ncbi.nlm.nih.gov/37286606/","source":"pubmed","updated_date":"2023-01-01T00:00:00","categories":"","keywords":"","citations":0,"references":"","extra":""}]
